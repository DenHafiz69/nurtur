{"nodes": [{"id": "readme_nurtur", "label": "Nurtur README", "file_type": "document", "source_file": "README.md", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_timer_honesty", "label": "How the Timer Stays Honest", "file_type": "concept", "source_file": "README.md", "source_location": "lines 101-125", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server stores UTC RFC3339 and is the only source of truth; the client mirrors state in localStorage but always reconciles to the server so lock/refresh/server-restart loses nothing."}, {"id": "readme_local_first_sync", "label": "Local-First Write Path with Debounced Push/Pull", "file_type": "concept", "source_file": "README.md", "source_location": "lines 89-93", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_single_instance_sync_constraint", "label": "One Server Instance per Database Constraint", "file_type": "concept", "source_file": "README.md", "source_location": "lines 95-97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The sync engine and one-active-feed constraints assume a single writer; this is a solo-user app, not a multi-tenant service."}, {"id": "readme_timeline_undo", "label": "History and In-Place Undo", "file_type": "concept", "source_file": "README.md", "source_location": "lines 150-167", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deleted row is replaced by a hidden placeholder so Undo can restore it into the exact same spot; restoration re-validates overlap and active-session rules."}, {"id": "readme_pwa_offline_shell", "label": "PWA Shell, Service Worker and Offline Page", "file_type": "concept", "source_file": "README.md", "source_location": "lines 169-183", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sw.js is served from the domain root so it controls the whole app; navigation is network-first and never cached because a cached authenticated page could outlive the sign-in gate."}, {"id": "readme_export_restore", "label": "JSON/CSV/SQL Export and Restore Drill", "file_type": "concept", "source_file": "README.md", "source_location": "lines 185-199, 337-380", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The SQL export includes schema_migrations and soft-deleted rows so it replays into a fresh Turso/SQLite database without re-running migrations and restores faithfully."}, {"id": "readme_local_account_onboarding", "label": "Local Account Onboarding with Signup Key", "file_type": "concept", "source_file": "README.md", "source_location": "lines 423-484", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One local PBKDF2-SHA256 account guarded by a signup key, with no email/OAuth dependency; auth stays optional and off by default for a solo user on a trusted LAN."}, {"id": "readme_healthz_endpoint", "label": "/healthz Health and Sync Status Endpoint", "file_type": "concept", "source_file": "README.md", "source_location": "lines 320-322", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_docker_glibc_runtime", "label": "Debian-slim (glibc) Docker Runtime for tursogo", "file_type": "concept", "source_file": "README.md", "source_location": "lines 303-322, 384-403", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tursogo loads a prebuilt native library through purego, so the image must be glibc-based (Debian slim, not Alpine); the service runs non-root with the DB on /data."}, {"id": "readme_self_hosted_fonts", "label": "Self-Hosted OFL Fonts (Fredoka + Nunito Sans)", "file_type": "concept", "source_file": "README.md", "source_location": "lines 229-230", "source_url": null, "captured_at": null,