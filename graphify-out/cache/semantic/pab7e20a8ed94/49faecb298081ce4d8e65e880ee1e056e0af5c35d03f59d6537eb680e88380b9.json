{"nodes": [{"id": "plans_nurtur_build_plan", "label": "Nurtur Build Plan", "file_type": "document", "source_file": "PLANS.md", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_phase1_nursing_core", "label": "Phase 1 \u2014 Foundation + Nursing Core", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 540-673", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ship Phase 1 to a real phone before starting Phase 2; timer reliability and thumb reach cannot be validated on a desktop browser."}, {"id": "plans_phase2_diapers_sleep_dashboard", "label": "Phase 2 \u2014 Diapers, Sleep + At-a-Glance Dashboard", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 675-760", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_phase3_timeline_undo_ship", "label": "Phase 3 \u2014 Timeline, Undo + Ship", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 764-874", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_turso_local_first_topology", "label": "Local-First Turso Topology (local file + async Push/Pull)", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 27-46, 194-215", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local Turso file is the authoritative write path for sub-millisecond logging at 3 a.m.; debounced Push and periodic Pull give a durable off-site copy, so a cloud outage never blocks a feed or diaper log."}, {"id": "plans_feeding_state_machine", "label": "Feeding State Machine (IDLE / ACTIVE(side))", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 217-233", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tapping the already-active side must be a no-op with a toast, and Done must never sit adjacent to a switch target, so a mis-tap cannot end the session."}, {"id": "plans_feed_segments_model", "label": "Feed Segments Model (derived per-side durations)", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 110, 134-148, 187", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single feeds row cannot represent left 8 min \u2192 right 12 min \u2192 left 3 min without losing when each side happened; totals are derived from segments so stored values never drift after edits."}, {"id": "plans_partial_unique_indexes", "label": "Partial Unique Indexes for Active Sessions", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 129-146, 192", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "one_active_feed, one_open_feed_segment and one_open_sleep back up the application checks so concurrent double-taps cannot create two active sessions."}, {"id": "plans_soft_delete_undo", "label": "Soft Delete (deleted_at) for Real Undo", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 44, 112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Soft delete enables real undo without confirmation dialogs, and deleted active sessions are closed first then soft-deleted in one transaction."}, {"id": "plans_progressive_enhancement_contract", "label": "Progressive Enhancement Contract", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 48-55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every mutation is a real form; HTMX only intercepts it, and without HTMX the server returns 303 See Other, so the app works with JS disabled."}, {"id": "plans_htmx_oob_convention", "label": "HTMX Out-of-Band Update Convention", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 57-64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never replace #app or the scroll container on a mutation; targeted outerHTML plus OOB companions is what prevents the page-jump problem."}, {"id": "plans_clock_injection", "label": "Injected Clock Interface (elapsed time in Go)", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 188, 497-501", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Elapsed time is computed in Go from a single injected Clock, not in SQL, so tests can freeze time and DST/midnight boundaries can be tested."}, {"id": "plans_thumb_first_principles", "label": "Design Principles (Thumb First, Cute but Quiet)", "file_type": "rationale", "source_file": "PLANS.md", "source_location": "lines 253-260", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The top 55% of the screen is for reading and the bottom 45% for acting; one primary decision per state; playful details must never compete with a control."}, {"id": "plans_night_first_palette", "label": "Night-First Day/Night Token Palette", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 262-313, 418-428", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Night is the default experience after 21:00 and day is the override, because the 3 a.m. session is the critical use case; the inline head script prevents a white flash."}, {"id": "plans_pip_mascot", "label": "Pip the Sprout Mascot", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 244-251", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pip (awake/nursing/sleeping/empty poses) is decoration with personality, never a status mechanism, and never sits on top of a control \u2014 text must always be sufficient."}, {"id": "plans_test_strategy", "label": "Layered Test Strategy (unit/integration/sync/concurrency/browser)", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 878-895", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_risk_register", "label": "Risks and Mitigations Register", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 898-914", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_non_goals_v1", "label": "Non-Goals for v1 (single user, single baby, no notifications)", "file_type": "concept", "source_file": "PLANS.md", "source_location": "lines 918-928", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Breadth is deliberately refused (no multi-user, multi-baby, charts, notifications, analytics) because the product wins on speed and reliability for one mother."}], "edges": [{"source": "plans_nurtur_build_plan", "target": "features_brief", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLANS.md", "source_location": "line 7", "weight": 1.0}, {"source": "plans_nurtur_build_plan", "target": "plans_phase1_nursing_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLANS.md", "source_location": "lines 15-19", "weight": 1.0}, {"source": "plans_nurtur_build_plan", "target": "plans_phase2_diapers_sleep_dashboard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLANS.md", "source_location": "lines 15-21", "weight": 1.0}, {"source": "plans_nurtur_build_plan", "target": "plans_phase3_timeline_undo_ship", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLANS.md", "source_location": "lines 19-21", "weight": 1.0}, {"source": "plans_phase2_diapers_sleep_dashboard", "target": "plans_phase1_nursing_core", "relation": "conceptually_related_to", "confi