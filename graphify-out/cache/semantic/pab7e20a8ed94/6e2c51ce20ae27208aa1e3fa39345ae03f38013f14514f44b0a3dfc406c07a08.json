{"nodes": [{"id": "web_templates_layout_layout", "label": "App Layout Shell", "file_type": "document", "source_file": "web/templates/layout.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_templates_layout_themebootstrap", "label": "Inline Theme Bootstrap Script", "file_type": "concept", "source_file": "web/templates/layout.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs synchronously in <head> before CSS paints, reading localStorage key nurtur.theme and hour-of-day (night = 21:00-07:00) so day/night theme is decided client-side without a flash of the wrong theme; the catch fallback still picks a night/day theme if storage or matchMedia throws."}, {"id": "web_templates_layout_viewdispatch", "label": "Server-Side View Dispatch", "file_type": "concept", "source_file": "web/templates/layout.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The layout is one shell that switches main content by .View (timeline / settings / default dashboard) instead of separate page layouts, keeping header, sync chip, dock and dialogs identical across screens; the dock is suppressed on settings."}, {"id": "web_templates_layout_sheetdialog", "label": "Action Dialog Sheet System", "file_type": "concept", "source_file": "web/templates/layout.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single persistent #action-dialog is filled by the .Sheet value (nursing/diaper/diaper-edit/sleep/sleep-edit) and opened via .SheetOpen, so HTMX swaps reuse one bottom-sheet container rather than shipping a dialog per partial."}], "edges": [{"source": "web_templates_layout_layout", "target": "web_templates_dashboard_dashboard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "