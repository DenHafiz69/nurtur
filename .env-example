# Nurtur environment settings.
#
# Copy this file, then edit the copy:
#
#   cp .env-example .env
#
# Nurtur reads .env from its working directory on startup. A variable that is
# already exported in your shell (or supplied by Docker/systemd) wins over the
# same name in this file. .env is gitignored; never commit real secrets.

# ---------- Server ----------
NURTUR_ADDR=:8080
NURTUR_DB=./data/nurtur.db
NURTUR_LOCAL_ONLY=true
NURTUR_TZ=Asia/Kuala_Lumpur
# Optional fallback. Onboarding normally saves the baby's name in the database.
# NURTUR_BABY_NAME=
NURTUR_LOG_LEVEL=info

# Night theme window, in the timezone above.
NURTUR_NIGHT_START=19:00
NURTUR_NIGHT_END=07:00

# ---------- Sign-in (recommended) ----------
# Set NURTUR_SIGNUP_KEY to a long phrase you only share with your household.
# Anyone with the key can create an account. Each account keeps its own baby
# profile, settings, and care log. Remove the key to close new signups.
# Uncomment and change these two values.
# NURTUR_SIGNUP_KEY=replace-with-a-long-shared-secret
# NURTUR_SESSION_SECRET=replace-with-output-of-openssl-rand-base64-32

# Leave false for plain-HTTP LAN use. Set true when serving over HTTPS.
NURTUR_COOKIE_SECURE=false

# Legacy single-passcode gate, used only when no account exists.
# NURTUR_PASSCODE=

# ---------- Turso Cloud sync (optional) ----------
# Only used when NURTUR_LOCAL_ONLY=false. Both values are then required.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# Local writes push within a few seconds; the periodic pull only reconciles
# out-of-band cloud changes. Five minutes suits a single server.
# NURTUR_SYNC_INTERVAL=5m

# ---------- Advanced ----------
# Read a different dotenv file instead of ./.env.
# NURTUR_ENV_FILE=/etc/nurtur/nurtur.env
