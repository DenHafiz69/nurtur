# Nurtur environment file. Keep this file readable only by the service user:
#   sudo install -m 600 -o root -g root deploy/nurtur.env.example /etc/nurtur/nurtur.env

NURTUR_ADDR=127.0.0.1:8080
NURTUR_DB=/var/lib/nurtur/nurtur.db
NURTUR_TZ=Asia/Kuala_Lumpur
# Optional fallback; onboarding normally stores the baby's name.
# NURTUR_BABY_NAME=

# Local-only mode needs no Turso credentials. Set this to false (and provide
# both Turso values) to sync to Turso Cloud.
NURTUR_LOCAL_ONLY=true
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# Local writes push within a few seconds; the periodic pull only reconciles
# out-of-band cloud changes. Five minutes suits a single server.
# NURTUR_SYNC_INTERVAL=5m

# Optional sign-in. NURTUR_SIGNUP_KEY lets the first browser create the one
# local account; after that, sign-in uses that username/password. The legacy
# NURTUR_PASSCODE gate still works when no account exists.
# NURTUR_SIGNUP_KEY=
# NURTUR_PASSCODE=
# NURTUR_SESSION_SECRET=
# NURTUR_COOKIE_SECURE=true

NURTUR_NIGHT_START=19:00
NURTUR_NIGHT_END=07:00
NURTUR_LOG_LEVEL=info
