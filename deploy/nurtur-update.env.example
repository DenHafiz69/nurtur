# Settings for /usr/local/bin/nurtur-update.
# Install this file as /etc/nurtur/update.env with mode 644.
#
# Absolute path to the standalone Compose file that defines Nurtur.
NURTUR_COMPOSE_FILE=/srv/nurtur/docker-compose.yml
# Compose service name, not the container_name.
NURTUR_COMPOSE_SERVICE=nurtur
