# Settings for /usr/local/bin/nurtur-backup.
# Install this file as /etc/nurtur/backup.env with mode 644.
#
# The Compose path and service name are normally shared with update.env:
#   NURTUR_COMPOSE_FILE=/srv/nurtur/docker-compose.yml
#   NURTUR_COMPOSE_SERVICE=nurtur
# Uncomment and adjust them here if you want backup-only overrides.

# Where snapshots are written. This directory lives on the VPS; copy it
# somewhere else as well if the VPS itself is lost.
NURTUR_BACKUP_DIR=/var/backups/nurtur
# Daily snapshots are small. Fourteen days is a reasonable starting point.
NURTUR_BACKUP_KEEP_DAYS=14
