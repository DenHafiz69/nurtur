[Unit]
Description=Nurtur baby tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nurtur
Group=nurtur
StateDirectory=nurtur
WorkingDirectory=/var/lib/nurtur
EnvironmentFile=/etc/nurtur/nurtur.env
ExecStart=/usr/local/bin/nurtur
Restart=on-failure
RestartSec=5s
TimeoutStopSec=40s

# The service only needs its own state directory and the network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nurtur

[Install]
WantedBy=multi-user.target
